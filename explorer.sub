;; The explorer: a dashboard over the shop's data (dashboard.sub), a page that runs queries in the query language
;; (query.sub), and a page with the database's tables. Its routes are in routes.sub.
(require-unqualified web-ui)
(require-unqualified compiler/macros)
(require-unqualified compiler/reader)
(require-unqualified std/string)
(require-unqualified sqlite)
(require-unqualified "routes.sub")
(require-unqualified "schema.sub")
(require-unqualified "query.sub")
(require-unqualified "data.sub")
(require-unqualified "results.sub")
(require-unqualified "views.sub")
(require-unqualified "dashboard.sub")

(provide explorer explorer-app)

(struct column-info [id u32] [name string] [type string])
(struct table-info [id u32] [name string] [title string] [size string] [few bool] [columns (ptr column-info)]
  [width u32] [text string])

(struct explorer-state [at place] [db (ptr sqlite)] [version string] [failed string] [board board]
  [shelf arena] [tables (ptr table-info)] [table-count u32] [shown (ptr table-info)] [rows result]
  [draft string] [talk arena] [talking bool] [sql string] [problem string] [summary string] [result result] [chart chart])

(variant explorer-message
  [went [to place]]
  [edited [text string]]
  [pressed [key string] [control bool] [meta bool]]
  [run]
  [example [text string]])

(define examples (array string 4)
  (array-of string
            "(from products\n  (where (< price 10))\n  (select name category price)\n  (order price))"
            "(from orders\n  (join products (= orders.product products.id))\n  (where (= products.category \"Tea\"))\n  (group (month orders.date))\n  (select (as (month orders.date) month) (as (sum orders.quantity) packs))\n  (order month))"
            "(from customers\n  (where (in country \"Spain\" \"Portugal\"))\n  (group city)\n  (select city (as (count) customers))\n  (order (desc customers)))"
            "(from orders\n  (group (year date))\n  (select (as (year date) year) (as (count) orders) (as (round (avg total) 2) average)))"))

(define example-names (array string 4) (array-of string "Cheap products" "Tea by month" "Iberian cities" "Years"))

(define source string "https://github.com/substrate-lang/sqlite-explorer")

;; ---- queries ----

(define (draft! [s (ptr explorer-state)] [text string])
  (free (-> s draft bytes))
  (set! (-> s draft) (string-copy text)))

(define (talk-free! [s (ptr explorer-state)])
  (when (-> s talking) (arena-free (& (-> s talk))))
  (set! (-> s talking) #f)
  (set! (-> s sql) "")
  (set! (-> s problem) "")
  (set! (-> s summary) "")
  (result-free! (& (-> s result)))
  (chart-free! (& (-> s chart))))

(define (located [message datum] [blamed datum] [loc (ptr srcloc)]) -> string
  (let ([text (datum->string message)] [at (if (== blamed 0) loc (syntax-srcloc blamed))] [b (make-buffer)])
    (cond [(string-prefix? text "query: ") (set! text (slice text 7))]
          [(string-prefix? text "read: ") (set! text (slice text 6))])
    (unless (== at 0)
      (buffer-add-string! (& b) "Line ")
      (write-digits (& b) (cast u64 (-> at line)) 10)
      (buffer-add-string! (& b) ", column ")
      (write-digits (& b) (cast u64 (+ (-> at col) 1)) 10)
      (buffer-add-string! (& b) ": "))
    (buffer-add-string! (& b) text)
    (buffer-string (& b))))

(define (summary-text [r (ptr result)]) -> string
  (let ([b (make-buffer)])
    (write-digits (& b) (cast u64 (-> r total)) 10)
    (buffer-add-string! (& b) (if (== (-> r total) 1) " row" " rows"))
    (when (> (-> r total) (-> r count)) (buffer-add-string! (& b) ", the first 200 shown,"))
    (if (< (-> r ms) 1.0)
        (buffer-add-string! (& b) " in under 1 ms")
        (begin (buffer-add-string! (& b) " in ") (write-number! (& b) (-> r ms)) (buffer-add-string! (& b) " ms")))
    (buffer-string (& b))))

(define (run! [s (ptr explorer-state)])
  (talk-free! s)
  (when (== (-> s db) 0) (return))
  (set! (-> s talk) (make-arena))
  (set! (-> s talking) #t)
  (let ([a (& (-> s talk))])
    (try (let ([forms (read-all (-> s draft) 'query)])
           (cond [(null? forms) (set! (-> s problem) "Write a query, such as (from orders (limit 10)).")]
                 [(pair? (cdr forms)) (set! (-> s problem) "Write one query at a time.")]
                 [else
                  (set! (-> s sql) (copy a (query-sql (car forms))))
                  (result-run! (& (-> s result)) (-> s db) (-> s sql))
                  (if (== (-> s result problem) "")
                      (begin
                        (chart-of! (& (-> s chart)) (& (-> s result)))
                        (set! (-> s summary) (copy a (summary-text (& (-> s result))))))
                      (set! (-> s problem) (-> s result problem)))]))
         [catch compile-error (message blamed loc) (set! (-> s problem) (copy a (located message blamed loc)))])))

(define (asked [s (ptr explorer-state)]) -> string
  (match (-> s at)
    [(ask f) (if (== (-> f q) 0) "" (@ (-> f q)))]
    [_ ""]))

(define (submit! [s (ptr explorer-state)])
  (if (== (asked s) (-> s draft))
      (run! s)
      (navigate! (route-href (ask (ask-form #:q (& (-> s draft))))))))

;; ---- the database ----

(define (tables! [s (ptr explorer-state)])
  (set! (-> s shelf) (make-arena))
  (let* ([a (& (-> s shelf))] [all schema] [n (length all)] [b (make-buffer)] [count result])
    (set! (-> s tables) (-> (new a table-info n) items))
    (set! (-> s table-count) n)
    (for ([i u32 0]) (< i n) (+= i 1)
      (let* ([t (+ (-> s tables) i)] [name (symbol->string (car (car all)))] [columns (cdr (car all))]
             [width (length columns)])
        (set! (-> t id) i)
        (set! (-> t name) (copy a name))
        (set! (-> b length) 0)
        (buffer-add-string! (& b) name)
        (buffer-add-string! (& b) " · SQLite explorer")
        (set! (-> t title) (copy a (buffer-string (& b))))
        (set! (-> b length) 0)
        (buffer-add-string! (& b) "(from ")
        (buffer-add-string! (& b) name)
        (buffer-add-string! (& b) "\n  (limit 50))")
        (set! (-> t text) (copy a (buffer-string (& b))))
        (set! (-> t columns) (-> (new a column-info width) items))
        (set! (-> t width) width)
        (for ([j u32 0]) (< j width) (+= j 1)
          (let ([c (+ (-> t columns) j)])
            (set! (-> c id) j)
            (set! (-> c name) (copy a (symbol->string (car (car columns)))))
            (set! (-> c type) (copy a (symbol->string (cadr (car columns)))))
            (set! columns (cdr columns))))
        (set! (-> b length) 0)
        (buffer-add-string! (& b) "(from ")
        (buffer-add-string! (& b) name)
        (buffer-add-string! (& b) " (select (count)))")
        (result-run! (& count) (-> s db) (query-sql (car (read-all (buffer-string (& b)) 'query))))
        (set! (-> t size) (copy a (if (== (-> count count) 0) "" (-> count rows cells text))))
        (set! (-> t few) (and (> (-> count count) 0) (<= (-> count rows cells value) 50.0)))
        (result-free! (& count))
        (set! all (cdr all))))
    (buffer-free! (& b))))

(define (table! [s (ptr explorer-state)] [name string])
  (result-free! (& (-> s rows)))
  (set! (-> s shown) 0)
  (for ([i u32 0]) (< i (-> s table-count)) (+= i 1)
    (when (== (-> (+ (-> s tables) i) name) name) (set! (-> s shown) (+ (-> s tables) i))))
  (unless (== (-> s shown) 0)
    (result-run! (& (-> s rows)) (-> s db) (query-sql (car (read-all (-> s shown text) 'query))))))

;; ---- the component ----

(define (arrived! [s (ptr explorer-state)] [to place])
  (set! (-> s at) to)
  (match to
    [(ask f)
     (if (== (-> f q) 0)
         (talk-free! s)
         (begin (draft! s (@ (-> f q))) (run! s)))]
    [(table name) (table! s name)]
    [_ (begin)]))

(define (explorer-update [s (ptr explorer-state)] [m (ptr explorer-message)])
  (match m
    [(went to) (arrived! s to)]
    [(edited text) (draft! s text)]
    [(pressed key control meta) (when (and (== key "Enter") (or control meta)) (submit! s))]
    [run (submit! s)]
    [(example text) (navigate! (route-href (ask (ask-form #:q (& text)))))]))

(define (explorer-init [s (ptr explorer-state)] [at place])
  (let* ([why string] [db (shop-open! (& why))])
    (set! (-> s draft) (string-copy (@ examples 0)))
    (set! (-> s version) (string-copy (sqlite-version)))
    (if (== db 0)
        (set! (-> s failed) (string-copy why))
        (begin
          (set! (-> s db) db)
          (board-run! (& (-> s board)) db)
          (tables! s)))
    (arrived! s at)))

(define (explorer-free [s (ptr explorer-state)])
  (talk-free! s)
  (result-free! (& (-> s rows)))
  (board-free! (& (-> s board)))
  (unless (== (-> s tables) 0) (arena-free (& (-> s shelf))))
  (unless (== (-> s db) 0) (sqlite-close (-> s db)))
  (free (-> s version bytes))
  (unless (== (-> s failed length) 0) (free (-> s failed bytes)))
  (free (-> s draft bytes)))

(define (at-query? [s (ptr explorer-state)]) -> bool (match (-> s at) [(ask f) #t] [_ #f]))

(define (at-database? [s (ptr explorer-state)]) -> bool (match (-> s at) [database #t] [(table name) #t] [_ #f]))

(define (showing? [s (ptr explorer-state)] [t (ptr table-info)]) -> bool
  (match (-> s at) [(table name) (== name (-> t name))] [_ #f]))

(define (table-title [s (ptr explorer-state)]) -> string
  (if (== (-> s shown) 0) "Database · SQLite explorer" (-> s shown title)))

(define (current [yes bool]) -> string (if yes "page" "false"))

(view (query-page [s (ptr explorer-state)])
  #:messages explorer-message
  (section ([class "query"])
    (h1 "Query")
    (p ([class "lede"])
       "Queries are written in a small query language, a Substrate DSL. This page turns each one into SQL and runs it "
       "with SQLite, here in your browser.")
    (textarea ([value (-> s draft)] [rows 8] [spellcheck "false"] [autocapitalize "off"] ["aria-label" "Query"]
               [on input (edited (event value))] [on keydown (pressed (event key) (event control) (event meta))]))
    (div ([class "actions"])
      (button ([class "run"] [on click run]) "Run")
      (span ([class "hint"]) "Ctrl+Enter or ⌘+Enter runs the query too."))
    (div ([class "examples"])
      (span "Examples:")
      (button ([on click (example (@ examples 0))]) (text (@ example-names 0)))
      (button ([on click (example (@ examples 1))]) (text (@ example-names 1)))
      (button ([on click (example (@ examples 2))]) (text (@ example-names 2)))
      (button ([on click (example (@ examples 3))]) (text (@ example-names 3))))
    (when (!= (-> s problem) "") (p ([class "problem"]) (text (-> s problem))))
    (when (!= (-> s sql) "") (div ([class "sql"]) (span "SQL") (pre (text (-> s sql)))))
    (when (!= (-> s summary) "") (p ([class "summary"]) (text (-> s summary))))
    (if (== (-> s chart kind) chart-bars)
        (bar-chart (& (-> s chart)))
        (when (== (-> s chart kind) chart-line) (line-chart (& (-> s chart)))))
    (when (> (-> s result width) 0) (result-table (& (-> s result))))))

(view (columns-view [t (ptr table-info)])
  (ul ([class "columns"])
    (each [c (-> t columns) (-> t width)] #:key (-> c id) (li (code (text (-> c name))) " " (span (text (-> c type)))))))

(view (table-card [t (ptr table-info)])
  (a ([class "table-card"] [href (route-href (table (-> t name)))])
    (h2 (text (-> t name)))
    (p (text (-> t size)) " rows")
    (columns-view t)))

(view (table-detail [s (ptr explorer-state)] [t (ptr table-info)])
  (div ([class "detail"])
    (p (text (-> t size)) " rows, in these columns:")
    (columns-view t)
    (p (if (-> t few) "Its rows, from this query:" "Its first 50 rows, from this query:"))
    (pre (text (-> t text)))
    (a ([class "open"] [href (route-href (ask (ask-form #:q (& (-> t text)))))]) "Open in the query page")
    (result-table (& (-> s rows)))))

(view (database-page [s (ptr explorer-state)])
  (section ([class "database"])
    (h1 "Database")
    (p ([class "lede"]) "The shop's three tables, in SQLite in this page.")
    (nav ([class "tabs"] [aria-label "Tables"])
      (each [t (-> s tables) (-> s table-count)] #:key (-> t id)
        (a ([href (route-href (table (-> t name)))] ["aria-current" (current (showing? s t))]) (text (-> t name)))))
    (match (-> s at)
      [(table name)
       (if (== (-> s shown) 0)
           (p "No table has this name. The tables are customers, products and orders.")
           (table-detail s (-> s shown)))]
      [_ (div ([class "overview"]) (each [t (-> s tables) (-> s table-count)] #:key (-> t id) (table-card t)))])))

