  .chart .label, .chart .value { font-size: 16px; }
  .explorer .top .bar { padding-top: 14px; padding-bottom: 14px; }
  .explorer .top nav { gap: 18px; }
}")

(component (explorer)
  #:state [s explorer-state]
  #:messages explorer-message
  #:update explorer-update
  #:init explorer-init
  #:free explorer-free
  #:route went
  #:style explorer-style
  (div ([class "explorer"])
    (header ([class "top"])
      (div ([class "bar"])
        (div ([class "brand"])
          (a ([class "wordmark"] [href "/"])
            (span ([class "mark"] [aria-hidden "true"]) (span ([class "mark-cursor"])))
            "substrate")
          (span ([class "slash"] [aria-hidden "true"]) "/")
          (a ([class "app"] [href (route-href dashboard)]) "SQLite explorer"))
        (nav ([aria-label "Explorer"])
          (a ([href (route-href dashboard)] ["aria-current" (current (route-current? dashboard))]) "Dashboard")
          (a ([href (route-href (ask (ask-form #:q 0)))] ["aria-current" (current (at-query? s))]) "Query")
          (a ([href (route-href database)] ["aria-current" (current (at-database? s))]) "Database")
          (a ([href source]) "GitHub ↗"))))
    (main
      (if (!= (-> s failed) "")
          (p ([class "problem"]) "The shop's database could not be made: " (text (-> s failed)))
          (match (-> s at)
            [dashboard (title "SQLite explorer") (dashboard-page (& (-> s board)))]
            [(ask f) (title "Query · SQLite explorer") (query-page s)]
            [database (title "Database · SQLite explorer") (database-page s)]
            [(table name) (title (table-title s)) (database-page s)]
            [lost
             (title "Not found · SQLite explorer")
             (section (h1 "Not found") (p "No page is at this address. " (a ([href (route-href dashboard)]) "The dashboard")
                                          " has the shop's figures."))])))
    (footer ([class "foot"])
      (div ([class "bar"])
        (p "SQLite " (text (-> s version)) " runs in this page, compiled to WebAssembly. The shop and its data are made up.")
        (a ([class "more"] [href source]) "Source on GitHub ↗")))))

;; The routes that a server renders: all but a query page with a query, which runs the visitor's SQL, and a table that
;; the schema does not have.
(define (rendered? [at (ptr place)]) -> bool
  (match at
    [(ask f) (== (-> f q) 0)]
    [(table name) (schema-table? name)]
    [_ #t]))

(app explorer-app (explorer) #:rendered rendered?)
